  return `<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Login Upload</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;
  min-height:100vh;
  display:flex;
  align-items:center;
