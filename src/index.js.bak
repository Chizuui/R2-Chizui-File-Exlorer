}
button:hover{background:#15803d}
.visitor-counter{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  background:rgba(37,99,235,0.1);
  padding:10px 20px;
  border-radius:12px;
  border:1px solid rgba(37,99,235,0.3);
