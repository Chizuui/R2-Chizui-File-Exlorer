      ${rows || `<tr><td class="empty" colspan="5">No files found</td></tr>`}
    </table>
  </div>
  <div class="visitor-counter">
    <span class="icon">👥</span>
    <span>Total Visitors: <b>${visitorCount || 0}</b></span>
  </div>
</div>
</body>
</html>`;
}

