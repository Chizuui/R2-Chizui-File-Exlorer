  color:#cbd5e1;
}
.progress{
  height:14px;
  background:#020617;
  border:1px solid #334155;
  border-radius:999px;
  overflow:hidden;
}
.progress-fill{
  height:100%;
  background:linear-gradient(90deg,#2563eb,#22c55e);
  border-radius:999px;
}
.storage-percent{
  margin-top:8px;
  color:#9ca3af;
  text-align:right;
  font-size:13px;
}
.upload{
  display:flex;
  gap:10px;
  justify-content:center;
  margin:18px 0 25px;
}
input[type=file]{
  padding:10px;
  background:#111827;
