  box-shadow:0 30px 80px rgba(0,0,0,.4);
}
h2{margin:0 0 8px;font-size:30px}
p{color:#9ca3af}
input{
  width:100%;
  margin:9px 0;
  padding:13px;
  background:#020617;
  color:white;
  border:1px solid #334155;
  border-radius:12px;
