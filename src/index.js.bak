      ${loggedIn ? `<a class="btn ghost" href="/logout">Logout</a>` : `<a class="btn" href="/login">Login Upload</a>`}
    </div>
  </div>

  <div class="storage-card">
    <div class="storage-info">
      <span>Storage Used</span>
      <b>${formatBytes(storageUsed)} / ${formatBytes(storageLimit)}</b>
    </div>
    <div class="progress">
      <div class="progress-fill" style="width:${storagePercent.toFixed(2)}%"></div>
    </div>
    <div class="storage-percent">${storagePercent.toFixed(2)}%</div>
  </div>

  <div class="card">
    ${loggedIn ? `
    <div class="admin-tools">
