{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "morning-heart-215e",
	"main": "src/index.js",
	"compatibility_date": "2026-05-03",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],

	"routes": [
		{
			"pattern": "files.chizui.dev",
			"custom_domain": true,
			"zone_name": "chizui.dev",
			"previews_enabled": false
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "__BUCKET_NAME__"
		}
	],
	"kv_namespaces": [
		{
			"binding": "STATS",
			"id": "__KV_NAMESPACE_ID__"
		}
	]
}